# Dashboard Dockerfile — Part 1 stub
# Build context is the project root (where the v0 GUI export lives).
# Full wiring to real data (Postgres API routes, auth) is done in Part 4.
# Uses node:22-alpine — required by pnpm 9+ (the lockfile version in this project).

FROM node:22-alpine AS deps
WORKDIR /app

# Pin pnpm to a version that runs on Node 22 and matches the lockfile format
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install

FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build the Next.js app (output: standalone is set in next.config.mjs)
RUN pnpm build

FROM node:22-alpine AS runner
WORKDIR /app

RUN apk add --no-cache python3 py3-pip py3-yaml

# Install dependencies for wp-hunter and seo-spam-hunter
COPY --from=builder /app/wp-hunter /tmp/wp-hunter
COPY --from=builder /app/seo-spam-hunter /tmp/seo-spam-hunter
RUN pip3 install --break-system-packages /tmp/wp-hunter /tmp/seo-spam-hunter && rm -rf /tmp/wp-hunter /tmp/seo-spam-hunter
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0

COPY --from=builder --chown=node:nodejs /app/.next/standalone ./
COPY --from=builder --chown=node:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=node:nodejs /app/public ./public
COPY --from=builder --chown=node:nodejs /app/wp-hunter ./wp-hunter
COPY --from=builder --chown=node:nodejs /app/seo-spam-hunter ./seo-spam-hunter

# Next.js standalone automatically copies .env files. Remove them to prevent @next/env 
# from mangling the bcrypt hash via $ expansion. We use compose `environment` instead.
RUN rm -f .env .env.*

USER node

EXPOSE 3000

# STABILIZATION FIX (BUG-008): Next.js binds 0.0.0.0; use 127.0.0.1 explicitly in wget to avoid Alpine IPv6 [::1] issue
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/ || exit 1

CMD ["node", "server.js"]
