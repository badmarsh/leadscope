      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nif (data.ok) {\n  const results = data.results || [];\n  for (const r of results) {\n    if (r.error) {\n      console.error(`Stage 2 campaign=${r.campaign_id} error: ${r.error}`);\n    } else {\n      console.log(`Stage 2 campaign=${r.campaign_id} type=${r.finder_type} inserted=${r.inserted_or_reopened} raw_hits=${r.raw_hits}`);\n    }\n  }\n} else {\n  console.error('Stage 2 run-all returned not-ok:', JSON.stringify(data));\n}\nreturn $input.all();"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Log Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    }
  ],
