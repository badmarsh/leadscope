{
  "name": "Stage 6 — Outreach Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "c3d4e5f6-0006-0001-0000-000000000001",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id as lead_id, c.id as contact_id, c.email, c.name, l.draft_email, ca.domain FROM leads l JOIN contacts c ON c.candidate_id = l.candidate_id JOIN candidates ca ON ca.id = l.candidate_id WHERE l.status = 'approved' AND c.mx_valid = true LIMIT 20;"
      },
      "id": "c3d4e5f6-0006-0001-0000-000000000002",
      "name": "Fetch Approved Contacts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [460, 300],
      "credentials": {
        "postgres": {
          "id": "leadscope-db",
          "name": "Leadscope Postgres"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env[\"OUTREACH_WEBHOOK_URL\"] }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "email", "value": "={{ $json.email }}"},
            {"name": "name", "value": "={{ $json.name }}"},
            {"name": "domain", "value": "={{ $json.domain }}"},
            {"name": "draft_email", "value": "={{ $json.draft_email }}"}
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0006-0001-0000-000000000003",
      "name": "Send to Outreach",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET status = 'contacted' WHERE id = {{$json.lead_id}}"
      },
      "id": "c3d4e5f6-0006-0001-0000-000000000004",
      "name": "Mark as Contacted",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [900, 300],
      "credentials": {
        "postgres": {
          "id": "leadscope-db",
          "name": "Leadscope Postgres"
        }
      }
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [
          {
            "node": "Fetch Approved Contacts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Approved Contacts": {
      "main": [
        [
          {
            "node": "Send to Outreach",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to Outreach": {
      "main": [
        [
          {
            "node": "Mark as Contacted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "tags": [
    {
      "name": "stage6"
    },
    {
      "name": "leadscope"
    }
  ],
  "meta": {
    "instanceId": "leadscope"
  }
}
