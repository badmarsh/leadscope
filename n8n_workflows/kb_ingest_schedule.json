{
  "name": "Knowledge Base Ingestion (Daily Schedule)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "b1b2c3d4-0001-0001-0001-000000000001",
      "name": "Daily Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://stages:8002/kb/ingest?background=true",
        "options": {
          "timeout": 120000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env[\"INTERNAL_API_TOKEN\"] }}"
            }
          ]
        }
      },
      "id": "b1b2c3d4-0001-0001-0001-000000000002",
      "name": "Trigger KB Ingestion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b1b2c3d4-0001-0001-0001-000000000003",
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "console.log('KB Ingestion trigger successfully initiated in background.');\nreturn $input.all();"
      },
      "id": "b1b2c3d4-0001-0001-0001-000000000004",
      "name": "Log Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const detail = $input.first().json.detail || 'Unknown error';\nconsole.error(`KB Ingestion trigger FAILED: ${detail}`);\nthrow new Error(`KB Ingestion trigger failed: ${detail}`);"
      },
      "id": "b1b2c3d4-0001-0001-0001-000000000005",
      "name": "Log Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        400
      ]
    }
  ],
  "connections": {
    "Daily Schedule Trigger": {
      "main": [
        [
          {
            "node": "Trigger KB Ingestion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger KB Ingestion": {
      "main": [
        [
          {
            "node": "Check Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Success": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": true,
  "tags": [
    {
      "name": "kb_ingest"
    },
    {
      "name": "leadscope"
    }
  ],
  "meta": {
    "instanceId": "leadscope"
  }
}
