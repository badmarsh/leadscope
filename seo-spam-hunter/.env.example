URLSCAN_API_KEY=
VT_API_KEY=

# CT log feed URL (Stage 0, seo-spam-hunter only)
# Options:
#   wss://certstream.calidog.io       (hosted, often flaky)
#   ws://localhost:4000               (certstream-server-go self-hosted — recommended)
#   wss://certstream.dev/ct          (certstream.dev Rust server)
CERTSTREAM_URL=ws://localhost:4000
