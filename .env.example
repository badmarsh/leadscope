# ─── .env.example ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=leadscope
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=leadscope
DATABASE_URL=postgresql://leadscope:change_me_strong_password@localhost:5432/leadscope

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_strong_password
N8N_ENCRYPTION_KEY=change_me_32_char_minimum_key_here

# ── Dashboard Auth ────────────────────────────────────────────────────────────
# Generate session secret with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=change_me_64_char_hex_secret
# Generate bcrypt hash with: node -e "const b=require('bcryptjs'); b.hash('yourpassword',12).then(console.log)"
DASHBOARD_PASSWORD_HASH=

# ── Gemini / LLM Proxy ───────────────────────────────────────────────────────
GEMINI_PROXY_ENDPOINT=http://llm-proxy:4000
GEMINI_PROXY_API_KEY=your_gemini_proxy_api_key
GEMINI_MODEL=gemini-3-flash

# ── OpenRouter (optional, fallback LLM) ──────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Search APIs ───────────────────────────────────────────────────────────────
EXA_API_KEY=your_exa_api_key
TAVILY_API_KEY=your_tavily_api_key
BRAVE_SEARCH_API_KEY=your_brave_api_key
SERPER_API_KEY=your_serper_api_key
SERPAPI_API_KEY=your_serpapi_api_key

# ── Firecrawl ─────────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-your_firecrawl_key
FIRECRAWL_ENDPOINT=https://api.firecrawl.dev

# ── Ollama (local model host) ─────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── Browserless ───────────────────────────────────────────────────────────────
BROWSERLESS_URL=http://browserless:3000/screenshot

# ── Next.js PG pool tuning ────────────────────────────────────────────────────
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000

# ── Cookie security ───────────────────────────────────────────────────────────
# Set to "true" in production (requires HTTPS)
COOKIE_SECURE=false

# ── Feature Flags & Extra APIs ────────────────────────────────────────────────
SHODAN_API_KEY=your_shodan_api_key
HUNTER_API_KEY=your_hunter_api_key
APOLLO_API_KEY=your_apollo_api_key
HUNTER_VERIFY_CONTACTS=true
FEW_SHOT_K=3
OUTREACH_WEBHOOK_URL=
